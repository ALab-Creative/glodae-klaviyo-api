# Mailchimp API Configuration
MAILCHIMP_API_KEY=your_api_key_here_example_xxxxxxxx-us21
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# CORS Configuration
ALLOWED_ORIGIN=https://your-store.com

# Mailchimp Merge Field Tag Names
# Update these to match your exact Mailchimp audience merge field tags
MAILCHIMP_FIELD_FNAME=FNAME
MAILCHIMP_FIELD_LNAME=LNAME
MAILCHIMP_FIELD_PHONE=PHONE
MAILCHIMP_FIELD_MSG=MSG
MAILCHIMP_FIELD_COUNTRY=COUNTRY
MAILCHIMP_FIELD_COMPATTN=COMPATTN
MAILCHIMP_FIELD_ADDRESS=ADDRESS
MAILCHIMP_FIELD_CMPDESC=CMPDESC
MAILCHIMP_FIELD_WEBSITE=WEBSITE
MAILCHIMP_FIELD_SOCIAL=SOCIAL
MAILCHIMP_FIELD_ESTVOL=ESTVOL

# Shopify Admin API Configuration (customer sync)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-01
SHOPIFY_REGULAR_CUSTOMER_TAG=CONTACT_REGULAR
SHOPIFY_WHOLESALE_CUSTOMER_TAG=CONTACT_WHOLESALE
